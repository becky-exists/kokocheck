# Native start does not auto-load .env. Export these or use node --env-file.
# The old FR_* names (FR_DATA_DIR, FR_PUBLIC_URL, ...) still work; KOKOCHECK_* wins when both are set.
HOST=127.0.0.1
PORT=4391
KOKOCHECK_PUBLIC_URL=http://localhost:4391
# KOKOCHECK_DATA_DIR=/absolute/private/kokocheck-data
# KOKOCHECK_SERVER_URL=http://localhost:4391
# KOKOCHECK_ADMIN_TOKEN=Generate-a-random-token-of-at-least-32-characters
# KOKOCHECK_WORKSPACE=/absolute/render-project
# By default the local auto-login (POST /api/local-session) works only when KOKOCHECK_PUBLIC_URL is a loopback address.
# Set to 1 only if you serve a non-loopback URL and trust everyone who can reach 127.0.0.1 on this machine.
# KOKOCHECK_ALLOW_LOCAL_SESSION=1
# Runner job folders (default: a private folder under the OS temp directory, outside KOKOCHECK_DATA_DIR)
# KOKOCHECK_JOBS_DIR=/absolute/private/jobs
# Restrict the MCP tools to these folders (separated like PATH). Unset = no restriction.
# KOKOCHECK_MCP_ALLOWED_DIRS=/absolute/renders:/absolute/review-downloads
# Local regular expressions (one per line) that release:source must not find in the files. Not part of the repository.
# KOKOCHECK_RELEASE_DENYLIST=/absolute/private/release-denylist.txt
