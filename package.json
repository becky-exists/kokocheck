{
  "name": "kokocheck",
  "version": "0.1.0",
  "description": "A self-hosted video review loop for humans, Codex and Claude Code.",
  "author": "Yuji Ooishi, doing business as Intervention Works",
  "license": "MIT",
  "homepage": "https://github.com/becky-exists/kokocheck",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/becky-exists/kokocheck.git"
  },
  "bugs": {
    "url": "https://github.com/becky-exists/kokocheck/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node build/server/index.js",
    "mcp": "tsx server/mcp.ts",
    "runner": "tsx server/runner.ts",
    "test": "tsx --test tests/*.test.ts",
    "demo": "tsx scripts/demo.ts",
    "security-check": "npm audit --audit-level=high",
    "doctor": "node scripts/doctor.mjs",
    "release:source": "node scripts/release.mjs",
    "setup:claude": "tsx scripts/setup-claude-channel.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "clsx": "^2.1.1",
    "express": "5.3.0",
    "lucide-react": "^0.468.0",
    "multer": "2.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.4"
  },
  "files": [
    "src/",
    "server/",
    "shared/",
    "scripts/",
    "tests/",
    "public/",
    "docs/",
    "index.html",
    "vite.config.ts",
    "tsconfig*.json",
    "Dockerfile",
    "compose.yaml",
    ".env.example",
    "LICENSE",
    "README.md",
    "README.ja.md",
    "SECURITY.md",
    "SECURITY.ja.md"
  ]
}
